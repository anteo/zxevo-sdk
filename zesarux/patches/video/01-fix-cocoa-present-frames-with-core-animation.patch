+    if (__atomic_exchange_n(&cocoa_frame_queued, 1, __ATOMIC_ACQ_REL)) return;
+    int width=(int)pixel_screen_width;
+    int height=(int)pixel_screen_height;
+    size_t length=(size_t)width * height * 4;
+    if (!pixel_screen_data || !length) {
+        __atomic_store_n(&cocoa_frame_queued, 0, __ATOMIC_RELEASE);
+        return;
+    }
+    if (length>cocoa_queued_frame_capacity) {
+        UInt8 *buffer=realloc(cocoa_queued_frame,length);
+        if (!buffer) {
+            __atomic_store_n(&cocoa_frame_queued, 0, __ATOMIC_RELEASE);
+            return;
+        }
+        cocoa_queued_frame=buffer;
+        cocoa_queued_frame_capacity=length;
+    }
+    memcpy(cocoa_queued_frame,pixel_screen_data,length);
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [cocoaView renderPixels:cocoa_queued_frame width:width height:height];
+        __atomic_store_n(&cocoa_frame_queued, 0, __ATOMIC_RELEASE);
+    });
 }
 
 
