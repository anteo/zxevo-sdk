+static int menu_select_neogs_file(char *title, char *filters[], char *previous, char *path)
+{
+    char current_dir[PATH_MAX];
+    if (!getcwd(current_dir, sizeof current_dir)) return 0;
+    if (previous[0]) {
+        char dir[PATH_MAX];
+        util_get_dir(previous, dir);
+        zvfs_chdir(dir);
+    }
+    int selected = menu_filesel(title, filters, path);
+    zvfs_chdir(current_dir);
+    return selected == 1;
+}
+
+static void menu_storage_neogs_rom(MENU_ITEM_PARAMETERS)
+{
+    char path[PATH_MAX] = "";
+    char *filters[] = {"rom", NULL};
+    if (!menu_select_neogs_file("Select NeoGS firmware", filters, neogs_rom_path, path)) return;
+    neogs_enable(path);
+}
+
+static void menu_storage_neogs_enable(MENU_ITEM_PARAMETERS)
+{
+    if (neogs_mode) gs_disable();
+    else if (neogs_rom_path[0]) neogs_enable(neogs_rom_path);
+    else menu_storage_neogs_rom(0);
+}
+
+static void menu_storage_neogs_sd_file(MENU_ITEM_PARAMETERS)
+{
+    char path[PATH_MAX] = "";
+    char *filters[] = {"img", "sd", "sdhc", "mmc", NULL};
+    if (menu_select_neogs_file("Insert NeoGS SD image", filters, neogs_sd_path, path))
+        neogs_sd_insert(path);
+}
+
+static void menu_storage_neogs_sd_eject(MENU_ITEM_PARAMETERS)
+{
+    neogs_sd_eject();
+}
+
