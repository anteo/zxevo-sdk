+static unsigned int neogs_ticks_at(int spectrum_tstates)
+{
+    if (spectrum_tstates <= 0 || screen_testados_linea <= 0) return 0;
+    return (uint64_t)spectrum_tstates * NEOGS_TICKS_PER_LINE / screen_testados_linea;
+}
+
+/* The shared ZX/GS mailbox changes on both CPUs. Deliver the GS cycles
