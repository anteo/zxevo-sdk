+/*
+ * NeoGS SD slot. The expansion card has its own SPI bus, independent
+ * of the Spectrum's MMC/SD controllers.
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "neogs_sd.h"
+#include "debug.h"
+
+enum { SD_BLOCK_SIZE = 512 };
+enum sd_stream { SD_COMMAND, SD_READ_MULTI, SD_WRITE_SINGLE, SD_WRITE_MULTI };
+
+char neogs_sd_path[PATH_MAX];
+
+static struct {
+    FILE *image;
+    uint64_t size;
+    uint64_t offset;
+    int protected;
+    int selected;
+    int idle;
+    int app_command;
+    int crc_enabled;
+    int high_capacity;
+    int block_addressing;
+    enum sd_stream stream;
+    z80_byte command[6];
+    unsigned int command_size;
+    z80_byte response[SD_BLOCK_SIZE + 5];
+    unsigned int response_size;
+    unsigned int response_pos;
+    z80_byte write_block[SD_BLOCK_SIZE + 2];
+    unsigned int write_size;
+} sd;
+
+void neogs_sd_select(int selected)
+{
+    if (sd.selected == selected) return;
+
+    sd.selected = selected;
+    sd.command_size = 0;
+    sd.response_size = sd.response_pos = 0;
+    sd.write_size = 0;
+    sd.stream = SD_COMMAND;
+    /* CMD55's prefix and card initialization survive a CS transition. */
+}
+
+int neogs_sd_insert(const char *path)
+{
+    int protected = 0;
+    FILE *image = fopen(path, "r+b");
+    if (!image) {
+        image = fopen(path, "rb");
+        protected = 1;
+    }
+
+    if (!image) {
+        debug_printf(VERBOSE_ERR, "Unable to open NeoGS SD image %s", path);
+        return 0;
+    }
+
+    off_t size = fseeko(image, 0, SEEK_END) == 0 ? ftello(image) : -1;
+    if (size < 4 * SD_BLOCK_SIZE || size % SD_BLOCK_SIZE != 0 ||
+        (uint64_t)size > (UINT64_C(1) << 41)) {
+        debug_printf(VERBOSE_ERR, "NeoGS SD requires a raw sector-aligned image between 2 KiB and 2 TiB");
+        fclose(image);
+        return 0;
+    }
+
+    neogs_sd_eject();
+    sd.image = image;
+    sd.size = size;
+    sd.protected = protected;
+    sd.idle = 1;
+    sd.high_capacity = sd.size >= (UINT64_C(2) << 30);
+    if (path != neogs_sd_path) snprintf(neogs_sd_path, sizeof neogs_sd_path, "%s", path);
+    return 1;
+}
+
+void neogs_sd_eject(void)
+{
+    if (sd.image) fclose(sd.image);
+
+    int selected = sd.selected;
+    memset(&sd, 0, sizeof sd);
+    sd.selected = selected;
+}
+
+int neogs_sd_inserted(void)
+{
+    return sd.image != NULL;
+}
+
+int neogs_sd_write_protected(void)
+{
+    return sd.protected;
+}
+
+static unsigned int sd_crc7(const z80_byte *data, unsigned int size)
+{
+    unsigned int crc = 0;
+    for (unsigned int i = 0; i < size; i++) {
+        crc ^= data[i];
+        for (int bit = 0; bit < 8; bit++) {
+            crc = ((crc << 1) ^ ((crc & 0x80) ? 0x12 : 0)) & 0xff;
+        }
+    }
+    return crc | 1;
+}
+
+static unsigned int sd_crc16(const z80_byte *data, unsigned int size)
+{
+    unsigned int crc = 0;
+    for (unsigned int i = 0; i < size; i++) {
+        crc ^= (unsigned int)data[i] << 8;
+        for (int bit = 0; bit < 8; bit++) {
+            crc = ((crc << 1) ^ ((crc & 0x8000) ? 0x1021 : 0)) & 0xffff;
+        }
+    }
+    return crc;
+}
+
+static void sd_reply(z80_byte value)
+{
+    sd.response[sd.response_size++] = value;
+}
+
+static void sd_reply_data(const z80_byte *data, unsigned int size)
+{
+    unsigned int crc = sd_crc16(data, size);
+    sd_reply(0xff);
+    sd_reply(0xfe);
+    memcpy(sd.response + sd.response_size, data, size);
+    sd.response_size += size;
+    sd_reply(crc >> 8);
+    sd_reply(crc);
+}
+
+static void sd_reply_csd(void)
+{
+    z80_byte csd[16] = {0};
+    csd[1] = 0x0e;
+    csd[3] = 0x32;
+    csd[4] = 0x5b;
+    csd[5] = 0x59;
+    csd[12] = 0x02;
+    csd[13] = 0x40;
+
+    if (sd.high_capacity) {
+        unsigned int c_size = sd.size / (512 * 1024) - 1;
+        csd[0] = 0x40;
+        csd[7] = (c_size >> 16) & 0x3f;
+        csd[8] = c_size >> 8;
+        csd[9] = c_size;
+    }
+    else {
+        uint64_t units = sd.size / (4 * SD_BLOCK_SIZE);
+        unsigned int multiplier = 0;
+        while (units > 4096 && multiplier < 7) {
+            units >>= 1;
+            multiplier++;
+        }
+        if (units > 4096) {
+            units >>= 1;
+            csd[5] = 0x5a;
+        }
+        unsigned int c_size = units - 1;
+        csd[6] = c_size >> 10;
+        csd[7] = c_size >> 2;
+        csd[8] = c_size << 6;
+        csd[9] = multiplier >> 1;
+        csd[10] = multiplier << 7;
+    }
+    csd[15] = sd_crc7(csd, sizeof csd - 1);
+    sd_reply_data(csd, sizeof csd);
+}
+
+static int sd_seek_block(void)
+{
+    return sd.offset <= sd.size - SD_BLOCK_SIZE &&
+        fseeko(sd.image, (off_t)sd.offset, SEEK_SET) == 0;
+}
+
+static void sd_reply_block(void)
+{
+    z80_byte block[SD_BLOCK_SIZE];
+    if (sd_seek_block() && fread(block, 1, sizeof block, sd.image) == sizeof block) {
+        sd_reply_data(block, sizeof block);
+        sd.offset += SD_BLOCK_SIZE;
+    }
+    else {
+        sd_reply(0x08); /* data error token: out of range or backing read failure */
+        sd.stream = SD_COMMAND;
+    }
+}
+
+static void sd_finish_write(void)
+{
+    unsigned int crc = sd.write_block[SD_BLOCK_SIZE] * 256u + sd.write_block[SD_BLOCK_SIZE + 1];
+    if (sd.crc_enabled && crc != sd_crc16(sd.write_block, SD_BLOCK_SIZE)) {
+        sd_reply(0x0b);
+    }
+    else if (!sd.protected && sd_seek_block() &&
+        fwrite(sd.write_block, 1, SD_BLOCK_SIZE, sd.image) == SD_BLOCK_SIZE &&
+        fflush(sd.image) == 0) {
+        sd_reply(0x05);
+        sd_reply(0x00); /* busy for one byte */
+        sd.offset += SD_BLOCK_SIZE;
+    }
+    else {
+        sd_reply(0x0d);
+    }
+    sd.write_size = 0;
+    if (sd.stream == SD_WRITE_SINGLE) sd.stream = SD_COMMAND;
+}
+
+static void sd_execute_command(void)
+{
+    unsigned int cmd = sd.command[0] & 0x3f;
+    uint32_t arg = ((uint32_t)sd.command[1] << 24) | ((uint32_t)sd.command[2] << 16) |
+        ((uint32_t)sd.command[3] << 8) | sd.command[4];
+    int app = sd.app_command;
+    sd.app_command = 0;
+
+    if ((sd.crc_enabled || cmd == 0 || cmd == 8) &&
+        sd_crc7(sd.command, sizeof sd.command - 1) != sd.command[5]) {
+        sd_reply(sd.idle | 0x08);
+        return;
+    }
+
+    switch (cmd) {
+        case 0: /* GO_IDLE_STATE */
+            sd.idle = 1;
+            sd.block_addressing = 0;
+            sd.crc_enabled = 0;
+            sd_reply(1);
+            return;
+        case 8: /* SEND_IF_COND */
+            sd_reply(sd.idle | ((arg & 0xf00) == 0x100 ? 0 : 0x40));
+            sd_reply(0);
+            sd_reply(0);
+            sd_reply((arg >> 8) & 0x0f);
+            sd_reply(arg);
+            return;
+        case 55: /* APP_CMD */
+            sd.app_command = 1;
+            sd_reply(sd.idle);
+            return;
+        case 41: /* ACMD41: SD_SEND_OP_COND */
+            if (!app) {
+                sd_reply(sd.idle | 4);
+                return;
+            }
+            if (sd.idle && (!sd.high_capacity || (arg & (1u << 30)))) {
+                sd.block_addressing = sd.high_capacity;
+                sd.idle = 0;
+            }
+            sd_reply(sd.idle);
+            return;
+        case 58: /* READ_OCR */
+            sd_reply(sd.idle);
+            sd_reply((sd.idle ? 0 : 0x80) | (sd.block_addressing ? 0x40 : 0));
+            sd_reply(0xff);
+            sd_reply(0x80);
+            sd_reply(0);
+            return;
+        case 59: /* CRC_ON_OFF */
+            sd.crc_enabled = arg & 1;
+            sd_reply(sd.idle);
+            return;
+    }
+
+    if (sd.idle) {
+        sd_reply(1);
+        return;
+    }
+
+    switch (cmd) {
+        case 9: /* SEND_CSD */
+            sd_reply(0);
+            sd_reply_csd();
+            break;
+        case 12: /* STOP_TRANSMISSION */
+            sd.stream = SD_COMMAND;
+            sd_reply(0xff); /* stuff byte before R1 */
+            sd_reply(0);
+            break;
+        case 13: /* SEND_STATUS */
+            sd_reply(0);
+            sd_reply(0);
+            break;
+        case 16: /* SET_BLOCKLEN */
+            sd_reply(arg == SD_BLOCK_SIZE ? 0 : 0x40);
+            break;
+        case 17: /* READ_SINGLE_BLOCK */
+        case 18: /* READ_MULTIPLE_BLOCK */
+        case 24: /* WRITE_BLOCK */
+        case 25: /* WRITE_MULTIPLE_BLOCK */
+            sd.offset = sd.block_addressing ? (uint64_t)arg * SD_BLOCK_SIZE : arg;
+            if (sd.offset % SD_BLOCK_SIZE || sd.offset > sd.size - SD_BLOCK_SIZE) {
+                sd_reply(0x20);
+                break;
+            }
+
+            sd_reply(0);
+            if (cmd == 17) sd_reply_block();
+            if (cmd == 18) sd.stream = SD_READ_MULTI;
+            if (cmd == 24) sd.stream = SD_WRITE_SINGLE;
+            if (cmd == 25) sd.stream = SD_WRITE_MULTI;
+            break;
+        default:
+            sd_reply(4);
+            break;
+    }
+}
+
+z80_byte neogs_sd_transfer(z80_byte value)
+{
+    if (!sd.selected || !sd.image) return 0xff;
+
+    if (sd.stream == SD_READ_MULTI && value == 0x4c && sd.command_size == 0) {
+        sd.stream = SD_COMMAND;
+        sd.response_size = sd.response_pos = 0;
+    }
+
+    if (sd.response_pos < sd.response_size) return sd.response[sd.response_pos++];
+    sd.response_size = sd.response_pos = 0;
+
+    if (sd.stream == SD_READ_MULTI) {
+        sd_reply_block();
+        return sd.response[sd.response_pos++];
+    }
+
+    if (sd.stream == SD_WRITE_SINGLE || sd.stream == SD_WRITE_MULTI) {
+        if (sd.write_size) {
+            sd.write_block[sd.write_size++ - 1] = value;
+            if (sd.write_size == sizeof sd.write_block + 1) sd_finish_write();
+        }
+        else if (value == (sd.stream == SD_WRITE_SINGLE ? 0xfe : 0xfc)) {
+            sd.write_size = 1;
+        }
+        else if (sd.stream == SD_WRITE_MULTI && value == 0xfd) {
+            sd.stream = SD_COMMAND;
+            sd_reply(0);
+        }
+    }
+    else if (sd.command_size || (value & 0xc0) == 0x40) {
+        sd.command[sd.command_size++] = value;
+        if (sd.command_size == sizeof sd.command) {
+            sd.command_size = 0;
+            sd_execute_command();
+        }
+    }
+
+    return 0xff;
+}
