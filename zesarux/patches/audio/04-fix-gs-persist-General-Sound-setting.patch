From: Anton Argirov <anton.argirov@gmail.com>
Date: Sat, 31 Oct 2026 20:53:44 +0700
Subject: [PATCH] fix(gs): persist General Sound setting

The General Sound option was lost between launches. Accept explicit enable
and disable options, restore the selected state at startup, and include it
when writing the emulator configuration.

---
 src/soundchips/gs.c |  1 +
 src/soundchips/gs.h |  1 +
 src/start.c         | 13 +++++++++++++
 src/utils.c         |  3 +++
 4 files changed, 18 insertions(+)

diff --git a/src/soundchips/gs.c b/src/soundchips/gs.c
index cc6300d..84cb7a2 100644
--- a/src/soundchips/gs.c
+++ b/src/soundchips/gs.c
@@ -37,6 +37,7 @@
 #include "audio.h"
 
 z80_bit gs_enabled={0};
+z80_bit gs_enabled_on_start={0};
 
 
 
diff --git a/src/soundchips/gs.h b/src/soundchips/gs.h
index 0e9fa10..764d32d 100644
--- a/src/soundchips/gs.h
+++ b/src/soundchips/gs.h
@@ -41,6 +41,7 @@
 
 
 extern z80_bit gs_enabled;
+extern z80_bit gs_enabled_on_start;
 extern void gs_enable(void);
 extern void gs_disable(void);
 extern void gs_fetch_opcodes_scanlines(void);
diff --git a/src/start.c b/src/start.c
index 6556d5a..69787eb 100644
--- a/src/start.c
+++ b/src/start.c
@@ -63,6 +63,7 @@
 #include "tape_smp.h"
 #include "audio.h"
 #include "audio_ayplayer.h"
+#include "gs.h"
 #include "screen.h"
 #include "screen_fx.h"
 #include "ay38912.h"
@@ -857,6 +858,8 @@ void zesarux_cmdline_help_expert(void)
 
 printf (
         "\n"
+        "--enablegeneralsound             Enable General Sound emulation\n"
+        "--disablegeneralsound            Disable General Sound emulation\n"
         "--audiovolume n                  Sets the audio output volume to percentage n\n"
         "--nagraaudio                     Enable Nagravision audio filter\n"
         "--zx8081vsyncsound               Enable vsync/tape sound on ZX80/81\n"
@@ -6816,6 +6819,14 @@ int parse_cmdline_options(int desde_commandline)
                                                                 audiodac_enabled.v=1;
             }
 
+            else if (!strcmp(argv[puntero_parametro],"--enablegeneralsound")) {
+                gs_enabled_on_start.v=1;
+            }
+
+            else if (!strcmp(argv[puntero_parametro],"--disablegeneralsound")) {
+                gs_enabled_on_start.v=0;
+            }
+
             else if (!strcmp(argv[puntero_parametro],"--audiodactype")) {
                     siguiente_parametro_argumento();
 
@@ -9126,6 +9137,8 @@ Also, you should keep the following copyright message, beginning with "Begin Cop
 
     reset_cpu();
 
+    if (gs_enabled_on_start.v) gs_enable();
+
     //Algun parametro que se resetea con reset_cpu y/o set_machine y se puede haber especificado por linea de comandos
     if (command_line_zx8081_vsync_sound.v) zx8081_vsync_sound.v=1;
 
diff --git a/src/utils.c b/src/utils.c
index 80cbbe5..a0a3fda 100644
--- a/src/utils.c
+++ b/src/utils.c
@@ -73,6 +73,7 @@
 #include "z88.h"
 #include "audio.h"
 #include "audio_ayplayer.h"
+#include "gs.h"
 #include "playtzx.h"
 #include "tape_tzx.h"
 #include "tape_pzx.h"
@@ -5514,6 +5515,8 @@ int util_write_configfile(void)
     if (audiodac_enabled.v)                         ADD_STRING_CONFIG,"--enableaudiodac");
                                                     ADD_STRING_CONFIG,"--audiodactype \"%s\"",audiodac_types[audiodac_selected_type].name);
 
+    if (gs_enabled.v)                               ADD_STRING_CONFIG,"--enablegeneralsound");
+
     if (tsconf_vdac_with_pwm.v)                     ADD_STRING_CONFIG,"--tsconf-vdac-with-pwm");
 
     if (snow_effect_enabled.v)                      ADD_STRING_CONFIG,"--snoweffect");
-- 
2.56.0

