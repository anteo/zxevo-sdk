From: Anton Argirov <anton.argirov@gmail.com>
Date: Mon, 9 Nov 2026 17:36:41 +0700
Subject: [PATCH] feat(tsconf): emulate VGA PWM sampling

Sample the FPGA's RGB222 PWM output with configurable ADC phase and
samples per scanline. This models the colors produced when a VGA
capture device digitizes TSConf's PWM signal.

---
diff --git a/src/cpu.c b/src/cpu.c
index 74c1420688664cb4e199bd7c307d9e0a8993dba4..9c19564b3959f6e41a67b3d4dfc492a8be378164 100644
--- a/src/cpu.c
+++ b/src/cpu.c
@@ -2985,9 +2985,8 @@ void set_machine_params(void)
                 ide_smuc_enabled.v=1;
             }
 
-            //TSConf hacemos que active siempre realvideo (siempre que setting de autoactivar este yes)
-            //por conveniencia, dado que se verá todo mejor asi que no con real video off
-            if (autodetect_rainbow.v) enable_rainbow();
+            // El muestreo VGA PWM necesita el renderizado por líneas.
+            if (autodetect_rainbow.v || tsconf_vga_pwm_phase>=0) enable_rainbow();
 
         break;
 
diff --git a/src/machines/tsconf.c b/src/machines/tsconf.c
index e5482c1b0db5ea1800352a878884443f5371b315..33a6c5cfe7f2849813383a148b9846f98268a930 100644
--- a/src/machines/tsconf.c
+++ b/src/machines/tsconf.c
@@ -21,6 +21,7 @@
 
 #include <stdio.h>
 #include <stdlib.h>
+#include <string.h>
 
 #include "cpu.h"
 #include "tsconf.h"
@@ -184,6 +185,8 @@ Y a partir de 24 todos son 255
 //Unreal emulator lo tiene con pwm activado (los colores son iguales que sin vdac)
 //Por defecto sin pwm, los 32 componentes de color todos distintos
 z80_bit tsconf_vdac_with_pwm={0};
+int tsconf_vga_pwm_phase=-1;
+int tsconf_vga_pwm_samples_per_line=TSCONF_VGA_DOTS_PER_LINE;
 
 /*
 Poner 3 modos de color:
@@ -1335,7 +1338,7 @@ mis opciones:
         */
 
         {
-          z80_byte status=tsconf_vdac_with_pwm.v==0 ? 7 : 0;
+          z80_byte status=(tsconf_vdac_with_pwm.v || tsconf_vga_pwm_phase>=0) ? 0 : 7;
           if (tsconf_powerup_pending.v) status|=0x40;
           tsconf_powerup_pending.v=0;
           return status;
@@ -2879,6 +2882,55 @@ int tsconf_if_tiles_one_enabled(void)
     else return 0;
 }
 
+// Nivel de salida del DAC RGB222 para una muestra de la tabla PWM de video_out.v.
+static unsigned int tsconf_pwm_dac_level(unsigned int component,unsigned int slot)
+{
+    static const z80_byte pwm[8]={0x00,0x01,0x41,0x45,0xA5,0xA7,0xD7,0xDF};
+    unsigned int level=component>>3;
+    return level+(level<3 && ((pwm[component&7]>>slot)&1));
+}
+
+static z80_int tsconf_sample_vga_pwm(z80_int rgb555,unsigned int slot)
+{
+    unsigned int red=tsconf_pwm_dac_level(rgb555>>10,slot);
+    unsigned int green=tsconf_pwm_dac_level((rgb555>>5)&31,slot);
+    unsigned int blue=tsconf_pwm_dac_level(rgb555&31,slot);
+
+    // La tabla RGB444 existente representa los cuatro niveles del DAC con 0, 5, 10 y 15.
+    return PRISM_INDEX_FIRST_COLOR+((red*5)<<8)+((green*5)<<4)+blue*5;
+}
+
+static void tsconf_apply_vga_pwm(int visible_scanline)
+{
+    if (tsconf_vga_pwm_phase<0 || visible_scanline<0 ||
+        visible_scanline>=get_total_alto_rainbow()/2) return;
+
+    const int width=TSCONF_DISPLAY_WIDTH;
+    const int ticks_per_line=TSCONF_VGA_DOTS_PER_LINE*2;
+    const int samples=tsconf_vga_pwm_samples_per_line;
+    z80_int *line=&rainbow_buffer[visible_scanline*2*width];
+    z80_int source_line[TSCONF_DISPLAY_WIDTH];
+    memcpy(source_line,line,sizeof source_line);
+
+    for (int x=0;x<width;x++) {
+        // La rejilla del ADC es independiente de fclk. Se proyecta cada muestra
+        // al píxel más cercano de la salida del emulador, sin cambiar su tamaño.
+        int sample=(2*x+1)*samples/ticks_per_line;
+        int tick=sample*ticks_per_line/samples+tsconf_vga_pwm_phase;
+        int source_x=tick/2;
+        z80_int color=source_x<width ? source_line[source_x] : TSCONF_INDEX_FIRST_COLOR;
+        if (color<TSCONF_INDEX_FIRST_COLOR ||
+            color>=TSCONF_INDEX_FIRST_COLOR+TSCONF_TOTAL_PALETTE_COLOURS) continue;
+
+        z80_int rgb555=color-TSCONF_INDEX_FIRST_COLOR;
+        // Cada píxel VGA dura dos semiperíodos de fclk. El RTL emite red1 antes de red0.
+        // La segunda copia de la línea selecciona los cuatro bits superiores de la tabla.
+        unsigned int slot=(tick&3)^1;
+        line[x]=tsconf_sample_vga_pwm(rgb555,slot);
+        line[x+width]=tsconf_sample_vga_pwm(rgb555,slot|4);
+    }
+}
+
 //Para zona de border o pantalla
 void screen_store_scanline_rainbow_solo_display_tsconf(void)
 {
@@ -2898,6 +2950,7 @@ void screen_store_scanline_rainbow_solo_display_tsconf(void)
     //Zona de borde superior o inferior. Dibujar directamente en buffer rainbow
     if (linea_render_visible<tsconf_current_border_height || linea_render_visible>=tsconf_current_border_height+tsconf_current_pixel_height) {
         tsconf_store_scanline_border_supinf_izqder(0);
+        tsconf_apply_vga_pwm(linea_render_visible);
         //No hay mas que eso en el scanline. volver
         return;
     }
@@ -3091,6 +3144,8 @@ int spritestiles=1;
         layer_five++;
         layer_six++;
     }
+
+    tsconf_apply_vga_pwm(linea_render_visible);
 }
 
 
