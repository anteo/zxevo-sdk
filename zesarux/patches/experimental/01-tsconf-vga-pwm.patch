@@ -6844,6 +6846,33 @@ int parse_cmdline_options(int desde_commandline)
                 tsconf_vdac_with_pwm.v=1;
             }
 
+            else if (!strcmp(argv[puntero_parametro],"--tsconf-vga-pwm-phase")) {
+                siguiente_parametro_argumento();
+                const char *value=argv[puntero_parametro];
+                char *end;
+                long phase=strtol(value,&end,10);
+                if (end==value || *end || phase < -1 || phase>3) {
+                    printf("Invalid value for --tsconf-vga-pwm-phase (expected -1..3)\n");
+                    exit(1);
+                }
+                tsconf_vga_pwm_phase=phase;
+                if (phase>=0 && MACHINE_IS_TSCONF) enable_rainbow();
+            }
+
+            else if (!strcmp(argv[puntero_parametro],"--tsconf-vga-pwm-samples-per-line")) {
+                siguiente_parametro_argumento();
+                const char *value=argv[puntero_parametro];
+                char *end;
+                long samples=strtol(value,&end,10);
+                if (end==value || *end || samples<TSCONF_VGA_PWM_MIN_SAMPLES ||
+                    samples>TSCONF_VGA_PWM_MAX_SAMPLES) {
+                    printf("Invalid value for --tsconf-vga-pwm-samples-per-line (expected %d..%d)\n",
+                        TSCONF_VGA_PWM_MIN_SAMPLES,TSCONF_VGA_PWM_MAX_SAMPLES);
+                    exit(1);
+                }
+                tsconf_vga_pwm_samples_per_line=samples;
+            }
+
 
             else if (!strcmp(argv[puntero_parametro],"--snoweffect")) {
                 snow_effect_enabled.v=1;
