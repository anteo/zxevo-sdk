+++ b/src/menu/menu_items_settings.c
@@ -9444,6 +9444,19 @@ void menu_display_tsconf_vdac(MENU_ITEM_PARAMETERS)
     menu_interface_rgb_inverse_common();
 }
 
+void menu_display_tsconf_vga_pwm_phase(MENU_ITEM_PARAMETERS)
+{
+    tsconf_vga_pwm_phase++;
+    if (tsconf_vga_pwm_phase>3) tsconf_vga_pwm_phase=-1;
+    if (tsconf_vga_pwm_phase>=0) enable_rainbow();
+}
+
+static void menu_display_tsconf_vga_pwm_samples(MENU_ITEM_PARAMETERS)
+{
+    menu_hardware_advanced_input_value(TSCONF_VGA_PWM_MIN_SAMPLES,TSCONF_VGA_PWM_MAX_SAMPLES,
+        "VGA ADC samples per line",&tsconf_vga_pwm_samples_per_line);
+}
+
 void menu_display_tsconf_pal_depth(MENU_ITEM_PARAMETERS)
 {
     tsconf_palette_depth--;
@@ -10213,6 +10226,19 @@ void menu_settings_display(MENU_ITEM_PARAMETERS)
             menu_add_item_menu_es_avanzado(array_menu_settings_display);
 
 
+            menu_add_item_menu_format(array_menu_settings_display,MENU_OPCION_NORMAL,menu_display_tsconf_vga_pwm_phase,NULL,
+                     "TSConf VGA PWM phase");
+            if (tsconf_vga_pwm_phase<0) menu_add_item_menu_sufijo_format(array_menu_settings_display," [Off]");
+            else menu_add_item_menu_sufijo_format(array_menu_settings_display," [%d]",tsconf_vga_pwm_phase);
+            menu_add_item_menu_tooltip(array_menu_settings_display,"Sample the onboard DAC waveform at one of four phases");
+            menu_add_item_menu_ayuda(array_menu_settings_display,"Samples the TSConf PWM waveform on both VGA scanlines. This experimental setting overrides the averaged PWM palette and requires RealVideo.");
+            menu_add_item_menu_es_avanzado(array_menu_settings_display);
+
+            menu_add_item_menu_format(array_menu_settings_display,MENU_OPCION_NORMAL,menu_display_tsconf_vga_pwm_samples,NULL,
+                     "TSConf VGA ADC samples/line [%d]",tsconf_vga_pwm_samples_per_line);
+            menu_add_item_menu_ayuda(array_menu_settings_display,"Sets the ADC clock for the VGA PWM phase mode, in samples per full horizontal line. 896 matches the TSConf pixel clock. Other values let the sample phase drift across the line.");
+            menu_add_item_menu_es_avanzado(array_menu_settings_display);
+
             menu_add_item_menu_format(array_menu_settings_display,MENU_OPCION_NORMAL,menu_display_tsconf_pal_depth,NULL,
                      "[%d] TSConf palette depth",tsconf_palette_depth);
             menu_add_item_menu_es_avanzado(array_menu_settings_display);
