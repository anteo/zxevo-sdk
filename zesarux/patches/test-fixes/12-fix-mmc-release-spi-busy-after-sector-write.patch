From: Anton Argirov <anton.argirov@gmail.com>
Date: Wed, 18 Nov 2026 17:16:00 +0700
Subject: [PATCH] fix(mmc): complete SPI responses after sector writes

Treat the CMD24 data token separately from the 512-byte payload, return
the second CMD13 status byte, and release MISO after the write response
and a short busy interval. Flush accepted data before completion and
reject protected or failed backing-image writes.

---
diff --git a/src/storage/mmc.c b/src/storage/mmc.c
index 53ccdd4..eb976ff 100644
--- a/src/storage/mmc.c
+++ b/src/storage/mmc.c
@@ -174,6 +174,7 @@
 static z80_byte tsconf_mmc_app_pending;
 static z80_byte tsconf_mmc_app_current;
 static z80_byte tsconf_mmc_reply=0xff;
+static z80_byte tsconf_mmc_r2_pending;
 
 static int tsconf_mmc_init_command(z80_byte command)
 {
@@ -650,6 +651,7 @@
         tsconf_mmc_app_pending=0;
         tsconf_mmc_app_current=0;
         tsconf_mmc_reply=0xff;
+        tsconf_mmc_r2_pending=0;
 }
 
 
@@ -886,8 +888,13 @@
     if ((MACHINE_IS_TSCONF || MACHINE_IS_BASECONF) && tsconf_mmc_init_command(mmc_last_command)) {
         /* R1 solo está disponible después de recibir los seis bytes. */
         if (mmc_index_command!=0) return 0xff;
+        if (mmc_last_command==0x4d && tsconf_mmc_r2_pending) {
+            tsconf_mmc_r2_pending=0;
+            return 0; /* CMD13 R2 status byte. */
+        }
         value=tsconf_mmc_reply;
         tsconf_mmc_reply=0xff;
+        if (mmc_last_command==0x4d && value!=0xff) tsconf_mmc_r2_pending=1;
         return value;
     }
 
@@ -1188,13 +1195,17 @@
 				if (mmc_write_index==2) value=0xff;
 				if (mmc_write_index==3) value=0xff;
 
-				//xxx0sss1
-				//sss: status:
-				//010 data accepted
-				if (mmc_write_index==4) value=4+1;
-
-
-				if (mmc_write_index>=5) value=4+1;
+				// Data response, a short busy interval, then released MISO.
+				if (mmc_write_index==4) {
+					if (mmc_write_protection[mmc_card_selected].v) value=0x0d;
+					else {
+						int persistent=mmc_persistent_writes[mmc_card_selected].v;
+						mmc_flush_flash_to_disk_una_tarjeta(mmc_card_selected);
+						value=(persistent && !mmc_persistent_writes[mmc_card_selected].v) ? 0x0d : 0x05;
+					}
+				}
+				if (mmc_write_index>=5 && mmc_write_index<8) value=0;
+				if (mmc_write_index>=8) value=0xff;
 
 				mmc_write_index++;
 
@@ -1340,6 +1351,7 @@
             tsconf_mmc_app_current=tsconf_mmc_app_pending;
             tsconf_mmc_app_pending=0;
             tsconf_mmc_reply=0xff;
+            tsconf_mmc_r2_pending=0;
         }
 
         //Solo mostraremos actividad en footer/icono SD en caso de nuevo comando y no de escritura de parametros
@@ -1529,18 +1541,18 @@
                                 }
 
 				//if (mmc_index_command==INICIO_WRITE_BLOCK_OFFSET) printf ("recibido byte gap\n");
-				//if (mmc_index_command==INICIO_WRITE_BLOCK_OFFSET+1) printf ("recibido data token\n");
-
-				if (mmc_index_command>=INICIO_WRITE_BLOCK_OFFSET+2 && mmc_index_command<=INICIO_WRITE_BLOCK_OFFSET+2+512-1) {
-					//printf ("Escribiendo byte numero %d valor: %d %c\n",mmc_index_command-(INICIO_WRITE_BLOCK_OFFSET+2),value,
+				//if (mmc_index_command==INICIO_WRITE_BLOCK_OFFSET+2) printf ("recibido data token\n");
+
+				if (mmc_index_command>=INICIO_WRITE_BLOCK_OFFSET+3 && mmc_index_command<=INICIO_WRITE_BLOCK_OFFSET+3+512-1) {
+					//printf ("Escribiendo byte numero %d valor: %d %c\n",mmc_index_command-(INICIO_WRITE_BLOCK_OFFSET+3),value,
 					//	(value>=31 && value<=127 ? value : '.'));
 
-					mmc_write_byte_memory(mmc_write_address+mmc_index_command-(INICIO_WRITE_BLOCK_OFFSET+2) , value);
+					mmc_write_byte_memory(mmc_write_address+mmc_index_command-(INICIO_WRITE_BLOCK_OFFSET+3) , value);
 				}
 
 
 				mmc_index_command++;
-				if (mmc_index_command==INICIO_WRITE_BLOCK_OFFSET+2+512) {
+				if (mmc_index_command==INICIO_WRITE_BLOCK_OFFSET+3+512) {
 					//printf ("byte final de escritura\n");
 					//mmc_index_command=0;
 				}
